        2     @test Parsers.parse(Number, "9223372036854775807") === 9223372036854775807
        2     @test Parsers.parse(Number, "170141183460469231731687303715884105727") === 170141183460469231731687303715884105727
        2     @test Parsers.parse(Number, "0e348") == big"0.0"
        -     # Int128 literal
        2     @test Parsers.parse(Number, "9223372036854775808") === 9223372036854775808
        -     # BigInt
        2     @test Parsers.parse(Number, "170141183460469231731687303715884105728") == 170141183460469231731687303715884105728
        -     # BigFloat promotion
        2     @test Parsers.parse(Number, "1e310") == Base.parse(BigFloat, "1e310")
        2     @test Parsers.parse(Number, "1.7976931348623157e310") == big"1.7976931348623157e310"
        -     # error case
        3     @test_throws Parsers.Error Parsers.parse(Number, "-")
        - end
        - 
        - # https://github.com/JuliaData/CSV.jl/issues/1063
        - @testset "Serialization" begin
        3     tempfile = tempname()
        1     Serialization.serialize(tempfile, Parsers.Options())
        2     @test Serialization.deserialize(tempfile).flags == Parsers.Options().flags
        - end
        - 
        - end # @testset "Parsers"
