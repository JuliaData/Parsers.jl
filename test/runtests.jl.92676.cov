        - @testset "BigInt" begin
        8     using Random
        1     rng = MersenneTwister(5)
        -     # Matches the generic integer parser (same grammar, flags, token length) on
        -     # values within Int128 range, across short and long tokens with trailing bytes.
        1     for _ in 1:5000
     5000         s = rand(rng, ("", "-", "+")) * String(rand(rng, '0':'9', rand(rng, 1:38)))
     5000         full = s * rand(rng, ("", "x", ",", "]", " "))
     5000         bytes = Vector{UInt8}(codeunits(full))
     5000         rbig = Parsers.xparse2(BigInt, bytes, 1, length(bytes))
     5000         r128 = Parsers.xparse2(Int128, bytes, 1, length(bytes))
    10000         @test Parsers.ok(rbig.code) == Parsers.ok(r128.code)
     5000         if Parsers.ok(rbig.code)
    10000             @test rbig.val == r128.val
    10000             @test rbig.tlen == r128.tlen
        -         end
     5000     end
        -     # Long tokens take the GMP converter and match Base, including leading
        -     # zeros, signs, and the subquadratic time (the old limb loop was ~250x
        -     # slower than Base's GMP conversion at 100k digits).
        1     for s in ("9"^384, "-" * "9"^385, "0"^500 * "123", "9"^5000,
        -               "0"^5000 * "123", "-" * "0"^5000 * "1"^60, "0"^5000)
       14         @test Parsers.parse(BigInt, s) == parse(BigInt, s)
       14         @test Parsers.parse(BigInt, s).size == parse(BigInt, s).size
        7     end
        1     big = "9"^1_000_000
        1     Parsers.parse(BigInt, big); parse(BigInt, big)      # warm up
        1     partime = minimum(@elapsed(Parsers.parse(BigInt, big)) for _ in 1:3)
        1     basetime = minimum(@elapsed(parse(BigInt, big)) for _ in 1:3)
        2     @test partime < 10 * basetime
        1     for s in ("", "-", "+", "1.5", "x", "12a")
       12         @test (Parsers.tryparse(BigInt, s) === nothing) == (Parsers.tryparse(Int128, s) === nothing)
        6     end
        - end
